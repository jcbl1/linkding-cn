{
  "name": "linkding-cn",
  "version": "1.1.0",
  "description": "Self-hosted bookmark manager - Chinese enhanced fork of linkding",
  "main": "index.js",
  "scripts": {
    "build": "npm run build-js && npm run build-theme-light && npm run build-theme-dark && npm run build-theme-nord && npm run build-theme-wireframe && npm run build-defuddle",
    "build-js": "rollup -c",
    "build-theme-light": "POSTCSS_DISABLE_CACHE=true postcss -o bookmarks/static/theme-light.css bookmarks/styles/theme-light.css",
    "build-theme-dark": "POSTCSS_DISABLE_CACHE=true postcss -o bookmarks/static/theme-dark.css bookmarks/styles/theme-dark.css",
    "build-theme-nord": "POSTCSS_DISABLE_CACHE=true postcss -o bookmarks/static/theme-nord.css bookmarks/styles/theme-nord.css",
    "build-theme-wireframe": "POSTCSS_DISABLE_CACHE=true postcss -o bookmarks/static/theme-wireframe.css bookmarks/styles/theme-wireframe.css",
    "build-defuddle": "node esbuild.config.mjs",
    "dev": "rollup -c -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcbl1/linkding-cn.git"
  },
  "keywords": [],
  "author": "jcbl1",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jcbl1/linkding-cn/issues"
  },
  "homepage": "https://github.com/jcbl1/linkding-cn#readme",
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@hotwired/turbo": "^8.0.23",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/wasm-node": "^4.62.2",
    "approx-string-match": "^2.0.0",
    "cssnano": "^8.0.2",
    "defuddle": "^0.19.1",
    "esbuild": "^0.28.1",
    "iconify-icon": "^3.0.2",
    "lit": "^3.3.3",
    "postcss": "^8.5.16",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0",
    "postcss-nesting": "^14.0.0",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "prettier": "^3.9.4"
  },
  "web-types": "./web-types.json",
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
